# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=memetic_layer_protocol
DB_REQUIRE_SSL=false

# Base Network Configuration
BASE_RPC_URL=https://mainnet.base.org
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here_for_settlement_operations

# Contract Address (deployed on Base mainnet)
CONTRACT_ADDRESS=0xdeB0E09366048944aC9033d5517Bf4Dcc39f2C97

# CoinGecko API Configuration (Free tier)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# COINGECKO_API_KEY=your_api_key_if_pro_tier

# Farcaster Configuration
NEYNAR_API_KEY=your_neynar_api_key_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Application Configuration
NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=debug

# Security
CORS_ORIGIN=http://localhost:3000

# Cache Configuration
REDIS_URL=redis://localhost:6379